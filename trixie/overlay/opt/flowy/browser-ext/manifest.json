{
  "manifest_version": 3,
  "name": "Flowy Browser Helper",
  "version": "1.0",
  "description": "Shows the on-screen keyboard when a text field gets focus, hides it when focus leaves.",
  "host_permissions": ["http://localhost:10000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }
  ]
}
