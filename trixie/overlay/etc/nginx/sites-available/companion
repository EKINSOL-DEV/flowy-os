server {
    listen 80;
    server_name _;

    # Companion PWA (static files)
    root /opt/flowy/companion;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;  # SPA fallback
    }

    # API proxy — single /api/ prefix strips it and forwards to FastAPI on port 10000.
    # This avoids conflicts between SPA routes (/photos, /music, /wifi, /alarms)
    # and API endpoints that share the same path prefixes.
    location /api/ {
        proxy_pass http://127.0.0.1:10000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        client_max_body_size 50m;
    }

    # Photo static files (not under /api/ — used directly in <img> src)
    location /photos-static/ {
        proxy_pass http://127.0.0.1:10000/photos-static/;
    }
}
