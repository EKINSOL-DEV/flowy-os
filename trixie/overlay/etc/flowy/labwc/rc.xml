<?xml version="1.0"?>
<!-- Minimal labwc config for Flowy browser mode. The touch device must be
     mapped to the output so touches follow its transform (rotate 270) —
     without this, touch input stays in panel-native portrait orientation. -->
<labwc_config>
  <placement><policy>automatic</policy></placement>
  <touch mapToOutput="DSI-2"/>
</labwc_config>
