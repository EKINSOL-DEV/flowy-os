[Unit]
Description=Kiosk Frontend Service
After=network.target nginx.service
Wants=network.target

[Service]
Type=simple
User=kiosk
Group=kiosk
WorkingDirectory=/opt/kiosk/frontend
ExecStart=/usr/bin/python3 -m http.server 8080
Restart=always
RestartSec=10
Environment=PATH=/opt/kiosk/venv/bin:$PATH

[Install]
WantedBy=multi-user.target