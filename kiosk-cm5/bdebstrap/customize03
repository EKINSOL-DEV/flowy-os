#!/bin/bash
# Services and configuration setup for Flowy kiosk
# Architecture: Weston (Wayland) + Chromium kiosk + nginx + FastAPI

set -e

echo "Setting up Flowy services and configuration..."

# --- Systemd services ---

# Copy new service files
cp /tmp/services/flowy-weston.service /etc/systemd/system/
cp /tmp/services/flowy-unified-api.service /etc/systemd/system/

# Install kiosk launcher script
cp /tmp/services/flowy-kiosk.sh /usr/bin/flowy-kiosk
chmod +x /usr/bin/flowy-kiosk

# Enable services
systemctl enable flowy-weston.service
systemctl enable flowy-unified-api.service
systemctl enable nginx

# Disable obsolete services (if present from older builds)
systemctl disable kiosk-frontend.service 2>/dev/null || true
systemctl disable kiosk-network.service 2>/dev/null || true

# Mask systemd-networkd-wait-online — it blocks boot for 2 min
# waiting for all interfaces. NetworkManager handles networking.
systemctl mask systemd-networkd-wait-online.service

# --- Weston configuration ---

mkdir -p /etc/xdg/weston
cp /tmp/weston.ini /etc/xdg/weston/weston.ini

# --- Nginx configuration ---

# Remove default nginx config
rm -f /etc/nginx/sites-enabled/default

# Install kiosk (port 8080) and companion (port 80) vhosts
cp /tmp/nginx-kiosk.conf /etc/nginx/sites-available/kiosk
cp /tmp/nginx-companion.conf /etc/nginx/sites-available/companion
ln -sf /etc/nginx/sites-available/kiosk /etc/nginx/sites-enabled/kiosk
ln -sf /etc/nginx/sites-available/companion /etc/nginx/sites-enabled/companion

# --- User setup ---

# Create flowy user if it doesn't exist
if ! id "flowy" &>/dev/null; then
    useradd -m -s /bin/bash flowy
    echo "flowy:demo" | chpasswd
    usermod -aG sudo,video,render,input flowy
fi

# --- Directory structure ---

mkdir -p /opt/flowy/kiosk
mkdir -p /opt/flowy/companion
mkdir -p /flowy/server/api
mkdir -p /flowy/photos
chown -R flowy:flowy /opt/flowy
chown -R root:root /flowy/server
chown -R root:root /flowy/photos

echo "Flowy services and configuration setup completed."
echo "  - Weston (Wayland compositor) → graphical.target"
echo "  - nginx :8080 (kiosk) + :80 (companion)"
echo "  - flowy-unified-api :10000 (FastAPI)"
echo "  - Chromium kiosk via /usr/bin/flowy-kiosk"
