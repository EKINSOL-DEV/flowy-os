#!/bin/sh

# pkgs we need for our kiosk
chroot $1 apt install -y cage chromium python-is-python3 python3-pip

SERVER_DIR="home/$IGconf_device_user1/server"

# Copy our server and give the kiosk ownership
cp -r ../flowy-image-server "$1/$SERVER_DIR"

# Install python packages
chroot "$1" /usr/bin/python -m pip install --break-system-packages -r /$SERVER_DIR/requirements.txt

# We'll run chromium like this - TODO: add kiosk flag
KIOSK_APP="/usr/bin/chromium-browser http://localhost:8080/docs --noerrdialogs --disable-infobars --no-first-run --ozone-platform=wayland --enable-features=OverlayScrollbar --start-maximized"

# Write out our systemd kiosk service
cat ../kiosk.service.tpl | sed \
   -e "s|<KIOSK_USER>|$IGconf_device_user1|g" \
   -e "s|<KIOSK_RUNDIR>|\/home\/$IGconf_device_user1|g" \
   -e "s|<KIOSK_APP>|$KIOSK_APP|g" \
   > $1/etc/systemd/system/kiosk.service

# Write out our systemd backend service (python)
cat ../kioskserver.service.tpl | sed \
   -e "s|<KIOSK_USER>|$IGconf_device_user1|g" \
   -e "s|<KIOSK_RUNDIR>|\/home\/$IGconf_device_user1|g" \
   -e "s|<SERVER_DIR>|/$SERVER_DIR|g" \
   > $1/etc/systemd/system/kioskserver.service

# Enable the kiosk service so it starts automatically

$BDEBSTRAP_HOOKS/enable-units "$1" kioskserver
$BDEBSTRAP_HOOKS/enable-units "$1" kiosk