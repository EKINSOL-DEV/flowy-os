#!/bin/sh

# NOTE: Packages are now defined in webkiosk/flowy/*.yaml files and referenced 
# in webkiosk/profile/flowy-kiosk instead of being installed here manually

# Create flowy directory and logs
mkdir -p $1/flowy/logs
chroot $1 chown -R $IGconf_device_user1:$IGconf_device_user1 /flowy

SERVER_DIR="/flowy/server"

# Copy our server and python requirements list
cp -r ../flowy-server "$1$SERVER_DIR"
cp ../pyreqs.txt "$1$SERVER_DIR/pyreqs.txt"

chroot $1 /usr/bin/python -m venv $SERVER_DIR/.venv
PYTHON_DIR=$SERVER_DIR/.venv/bin

chroot $1 $PYTHON_DIR/pip install -r $SERVER_DIR/pyreqs.txt


# Set up chromium arguments (commented out for flowy-app.deb installation)
# KIOSK_APP="/usr/bin/chromium-browser http://localhost:8080/ --kiosk --noerrdialogs --disable-infobars --no-first-run --ozone-platform=wayland --enable-features=OverlayScrollbar --start-maximized --force-device-scale-factor=1.0 --disable-features=TranslateUI"

SYS_DIR="$1/etc/systemd/system"
# Use unified API instead of individual services
for service in weston kioskserver unified-api; do
   case $service in
      weston)
         sed -e "s|<KIOSK_USER>|$IGconf_device_user1|g" \
            ../services/$service.service.tpl > $SYS_DIR/flowy-$service.service
         ;;
      kioskserver)
         sed -e "s|<KIOSK_USER>|$IGconf_device_user1|g" \
             -e "s|<SERVER_DIR>|$SERVER_DIR/wifi-web|g" \
             -e "s|<PYTHON_EXEC>|$PYTHON_DIR/python|g" \
            ../services/$service.service.tpl > $SYS_DIR/flowy-$service.service
            ;;
      wifiserver) # TODO: remove this service
         sed -e "s|<KIOSK_USER>|$IGconf_device_user1|g" \
             -e "s|<SERVER_DIR>|$SERVER_DIR/wifi|g" \
             -e "s|<PYTHON_EXEC>|$PYTHON_DIR/python|g" \
            ../services/$service.service.tpl > $SYS_DIR/flowy-$service.service
            ;;
      ledserver)
         sed -e "s|<KIOSK_USER>|$IGconf_device_user1|g" \
             -e "s|<SERVER_DIR>|$SERVER_DIR/led|g" \
             -e "s|<PYTHON_EXEC>|$PYTHON_DIR/python|g" \
            ../services/$service.service.tpl > $SYS_DIR/flowy-$service.service
            ;;
      display-rotation) # TODO: remove this service
         sed -e "s|<KIOSK_USER>|$IGconf_device_user1|g" \
            ../services/$service.service.tpl > $SYS_DIR/flowy-$service.service
            ;;
      nfcserver) # TODO: remove this service
         sed -e "s|<SERVER_DIR>|$SERVER_DIR|g" \
             -e "s|<PYTHON_EXEC>|$PYTHON_DIR/python|g" \
            ../services/$service.service.tpl > $SYS_DIR/flowy-$service.service
            ;;
      unified-api)
         sed -e "s|<KIOSK_USER>|$IGconf_device_user1|g" \
             -e "s|<SERVER_DIR>|$SERVER_DIR/api|g" \
             -e "s|<PYTHON_EXEC>|$PYTHON_DIR/python|g" \
             -e "s|<PYTHON_DIR>|$PYTHON_DIR|g" \
            ../services/$service.service.tpl > $SYS_DIR/flowy-$service.service
            ;;
   esac

   # Enable the service
   $BDEBSTRAP_HOOKS/enable-units "$1" flowy-$service
done

# Install flowy protocol handler
cp ../flowy-protocol-handler.sh "$1/usr/local/bin/flowy-protocol-handler.sh"
chmod +x "$1/usr/local/bin/flowy-protocol-handler.sh"

# Install protocol handler desktop file system-wide
mkdir -p "$1/usr/share/applications"
cp ../flowy-protocol.desktop "$1/usr/share/applications/"

# labwc configuration removed - using Weston now

# Configure Weston using template
mkdir -p "$1/etc/xdg/weston"
cp ../../templates/rpi/weston.ini "$1/etc/xdg/weston/weston.ini"

# Configure Plymouth splash screen
echo "Configuring Plymouth splash screen..."

# Install flowy theme from archive
if [ -n "$FLOWY_OUTPUT_DIR" ] && [ -f "$FLOWY_OUTPUT_DIR/themes/flowy.tar.xz" ]; then
    echo "Installing flowy Plymouth theme..."
    mkdir -p "$1/usr/share/plymouth/themes"
    cd "$1/usr/share/plymouth/themes"
    tar -xf "$FLOWY_OUTPUT_DIR/themes/flowy.tar.xz"
    cd - > /dev/null
    echo "✅ Flowy theme installed"
else
    echo "⚠️  Flowy theme archive not found, using default Plymouth theme"
fi

# Set default theme to flowy
chroot $1 plymouth-set-default-theme flowy

# Configure kernel command line for silent boot with Plymouth
CMDLINE_FILE="$1/boot/firmware/cmdline.txt"
if [ -f "$CMDLINE_FILE" ]; then
    # Add Plymouth and quiet boot parameters
    sed -i 's/$/ quiet splash plymouth.ignore-serial-consoles/' "$CMDLINE_FILE"
else
    echo "Warning: cmdline.txt not found, Plymouth may not work properly"
fi

# Update initramfs to include Plymouth
chroot $1 update-initramfs -u

# Fix TTY permissions for Weston seat management
echo 'KERNEL=="tty[0-9]*", GROUP="tty", MODE="0660"' > $1/etc/udev/rules.d/99-tty-permissions.rules

# Fix flowy-app desktop file path and add performance flags for Electron
if [ -f $1/usr/share/applications/flowy-app.desktop ]; then
    sed -i 's|Exec=/opt/flowy-app/flowy-app|Exec=/usr/lib/flowy-app/flowy-app --no-sandbox --disable-infobars --enable-features=OverlayScrollbar,TouchpadAndWheelScrollLatching,UseOzonePlatform --force-device-scale-factor=1.0 --disable-features=TranslateUI --disable-gpu-sandbox --enable-gpu-rasterization --ozone-platform-hint=wayland --ozone-platform=wayland --touch-events=enabled --enable-native-gpu-memory-buffers|' $1/usr/share/applications/flowy-app.desktop
fi

# Ensure systemd-logind is enabled for proper seat management
chroot $1 systemctl enable systemd-logind

# Install root filesystem expansion service (runs once on first boot)
cp ../scripts/expand-rootfs.sh "$1/usr/local/bin/expand-rootfs.sh"
chmod +x "$1/usr/local/bin/expand-rootfs.sh"
cp ../services/expand-rootfs.service.tpl $SYS_DIR/expand-rootfs.service
mkdir -p "$1/var/lib/flowy"
touch "$1/var/lib/flowy/.expand-rootfs"
$BDEBSTRAP_HOOKS/enable-units "$1" expand-rootfs